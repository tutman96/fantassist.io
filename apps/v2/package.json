{
  "name": "@fantassist/v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "shader:check": "for shader in src/renderer/vgpu/shaders/*.wgsl; do vgpu check \"$shader\" --require-validation || exit 1; done",
    "test": "node --import tsx --test test/*.test.ts",
    "render:scene": "tsx scripts/render-scene.ts",
    "render:performance": "npm run render:scene -- --performance --out artifacts/performance-4k.png",
    "check": "npm run lint && npm run typecheck && npm run shader:check && npm test && npm run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "localforage": "^1.10.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "protobufjs": "^8.7.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vgpu": "0.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "^6.2.5",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
