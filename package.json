{
  "name": "fantassist.io",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:compile && node --test \".test-dist/tests/**/*.test.js\"",
    "test:compile": "tsc --project tsconfig.tests.json",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "gen-proto": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/ --ts_proto_opt=esModuleInterop=true ./protos/*"
  },
  "dependencies": {
    "@datadog/browser-rum": "^5.23.3",
    "@emotion/cache": "^11.13.1",
    "@emotion/react": "^11.7.1",
    "@emotion/styled": "^11.6.0",
    "@gera2ld/tarjs": "^0.3.1",
    "@mui/icons-material": "^5.2.5",
    "@mui/material": "^5.2.5",
    "@mui/material-nextjs": "^6.0.1",
    "@mui/system": "^5.2.5",
    "@rehooks/component-size": "^1.0.3",
    "canvas": "^3.2.3",
    "konva": "^9.3.11",
    "localforage": "^1.10.0",
    "lru-cache": "^6.0.0",
    "mui-color-input": "^3.0.0",
    "next": "^14.2.16",
    "protobufjs": "^6.11.3",
    "react": "^18",
    "react-dom": "^18",
    "react-helmet": "^6.1.0",
    "react-konva": "^18.0.0",
    "rxjs": "^7.8.1",
    "uuid": "^8.1.0"
  },
  "devDependencies": {
    "@types/lru-cache": "^5.1.0",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^8.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "ts-proto": "^1.96.1",
    "typescript": "^5"
  }
}
