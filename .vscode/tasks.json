{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OpenCode",
      "type": "process",
      "command": "${workspaceFolder}/.opencode/start.zsh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "focus": false,
        "panel": "dedicated",
        "reveal": "always",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
